    print("\n" + "="*70)
    print("🔥 HIGH RSI PUMP FINDER SCANNER")
    print(" ONLY RSI 70+ COINS (OVERBOUGHT)")
    print("="*70)
  
    # First verify RSI accuracy
    verify_rsi_accuracy()
    
    print("\n" + "="*70)
    print("SCANNING CRITERIA:")
    print("• RSI MUST BE 70-85 (Overbought)")
    print("• DMI crossover (+DI above -DI)")
    print("• ADX > 20 (strong trend)")
    print("• Volume surge (>1.5x average)")
    print("• Low price (<$0.5)")
    print("="*70)
  
    seen = set()
    scan_count = 0
    
    while True:
        try:
            scan_count += 1
            print(f"\n🔄 SCAN #{scan_count} - {datetime.now().strftime('%H:%M:%S')}")
            
            results = run_pump_scanner()
            if results:
                results.sort(key=lambda x: x['score'], reverse=True)
                
                # Show new alerts
                new_alerts = []
                for r in results:
                    key = (r['exchange'], r['symbol'], r['tf'])
                    if key not in seen:
                        new_alerts.append(r)
                        seen.add(key)
                
                if new_alerts:
                    print(f"\n🚨 NEW ALERTS FOUND: {len(new_alerts)}")
                    for r in new_alerts:
                        price = r['price']
                        if price < 0.001:
                            price_str = f"${price:.6f}"
                        elif price < 0.01:
                            price_str = f"${price:.5f}"
                        elif price < 0.1:
                            price_str = f"${price:.4f}"
                        else:
                            price_str = f"${price:.3f}"
                        
                        alert = f"{r['exchange']} {r['symbol']} {r['tf']} | RSI:{r['rsi']:.1f} | Score:{r['score']} | ${price_str} | Change:{r['change']:+.1f}% | Vol:{r['volume_ratio']:.1f}x"
                        print(f"   ⚡ {alert}")
                
                # Always display full results
                top_results = display_results(results)
            else:
                print("\n📭 No HIGH RSI setups found this scan.")
            
            print(f"\n⏳ Next scan in 3 minutes...")
